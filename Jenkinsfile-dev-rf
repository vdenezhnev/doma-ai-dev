def Notify(STATUS) {
    withCredentials([string(credentialsId: 'botToken', variable: 'TOKEN'), string(credentialsId: 'chatID', variable: 'CHAT_ID')]) {
    sh """
    curl --request POST \
    --url 'https://api.telegram.org/bot${TOKEN}/sendMessage' \
    --header 'Content-Type: application/json' \
    --data '
    {
        "chat_id": ${CHAT_ID}, 
        "parse_mode": "Markdown", 
        "reply_to_message_id": 6, 
        "text": "${STATUS}"
    }
    ' || true
    """
    }
}
pipeline {
    agent any
    triggers {
        pollSCM('* * * * *') // Enabling build on Push
    }
    parameters {
        booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Deploy')
    }
    environment {
        SERVER='37.18.27.32'
        WORK_DIR='/opt/acms'
        API_HOST='https://devapi.smartairkey.com/'
        APP_INTERCOM_TITLE='SmartAirkey'
        APP_BRAND_ID='smartairkey'
        APP='acms-dev-rf'
    }
    stages {
        stage('Prepare') {
            when {
                expression { env.BRANCH_NAME == 'dev_Net6_RF' }
            }
            steps {
                Notify("""🔔 DEPLOY STARTED 🔔\nAPP: ${env.APP}\nBRANCH: ${env.GIT_BRANCH}\nCOMMIT: ${env.GIT_COMMIT}""".replaceAll('\\_','\\\\-'))
                sshagent(credentials : ['infra-key']) {
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo mkdir -p ${WORK_DIR}'
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo rm -rf ${WORK_DIR}/*'
                    sh 'tar -cvzf acms.tar.gz ./*'
                    sh 'scp acms.tar.gz infrastructure@${SERVER}:${WORK_DIR}'
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo tar -xvf ${WORK_DIR}/acms.tar.gz -C ${WORK_DIR}'
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo chown -R infrastructure:infrastructure ${WORK_DIR}'
                }
            }
        }
        stage('Build image') {
            when {
                expression { env.BRANCH_NAME == 'dev_Net6_RF' }
            }
            steps {
                sshagent(credentials : ['infra-key']) {
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo docker build --no-cache -t smartairkey/acms-dev:late --build-arg API_HOST="${API_HOST}" --build-arg APP_INTERCOM_TITLE="${APP_INTERCOM_TITLE}" --build-arg APP_BRAND_ID="${APP_BRAND_ID}" ${WORK_DIR}'
                }
            }
        }
        stage('Deploy') {
            when {
                expression { env.BRANCH_NAME == 'dev_Net6_RF' }
            }
            steps {
                sshagent(credentials : ['infra-key']) {
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo docker compose -f ${WORK_DIR}/docker-compose-dev-rf.yml stop'
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo docker compose -f ${WORK_DIR}/docker-compose-dev-rf.yml rm -f acms'
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo docker compose -f ${WORK_DIR}/docker-compose-dev-rf.yml up -d --force-recreate'
                    sh 'ssh -o StrictHostKeyChecking=no infrastructure@${SERVER} sudo docker system prune -a -f'
                }
                Notify("""✅ DEPLOY SUCESSFULL ✅\nAPP: ${env.APP}\nBRANCH: ${env.GIT_BRANCH}\nCOMMIT: ${env.GIT_COMMIT}""".replaceAll('\\_','\\\\-'))
            }
        }
    }
    
    post {
        failure {
            Notify("""❌ DEPLOY FAILED ❌\nAPP: ${env.APP}\nBRANCH: ${env.GIT_BRANCH}\nCOMMIT: ${env.GIT_COMMIT}""".replaceAll('\\_','\\\\-'))
        }
        aborted {
            Notify("""🚫 DEPLOY CANCELED 🚫\nAPP: ${env.APP}\nBRANCH: ${env.GIT_BRANCH}\nCOMMIT: ${env.GIT_COMMIT}""".replaceAll('\\_','\\\\-'))
        }
        cleanup {
            deleteDir()
        }
    }    
}